# Optional local overrides. Copy values into the process environment; do not commit real secrets.
PORT=4173

# Ark CLI JavaScript entry when the default global npm path is unavailable.
# ARKCLI_SCRIPT=C:\path\to\node_modules\@volcengine\ark-cli\scripts\run.js

# Codex video-copy-extractor script used for Douyin imports.
# VIDEO_FETCH_SCRIPT=C:\path\to\video-copy-extractor\scripts\fetch_video.mjs
# VIDEO_ANALYZER_SCRIPT=C:\path\to\video-copy-extractor\scripts\analyze_video.py
# CODEX_NODE_MODULES=C:\path\to\codex-node_modules

# Optional VVV Remotion checkout and ffmpeg-skill checkout.
# VVV_ROOT=E:\path\to\vvv
# FFMPEG_SKILL_ROOT=C:\Users\<user>\.codex\skills\ffmpeg-skill

# Optional binary overrides.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
# PYTHON_PATH=C:\path\to\python.exe

# Optional writable data directory.
# XYING_DATA_DIR=E:\xying-data
